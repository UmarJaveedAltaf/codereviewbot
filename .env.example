# ── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token with repo + pull_requests scopes
GITHUB_TOKEN=ghp_...
# Secret set in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Slack ────────────────────────────────────────────────────────────────────
# Incoming webhook URL from your Slack app. Leave blank to disable.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=code_reviews

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Model selection (optional overrides) ─────────────────────────────────────
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
