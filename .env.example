# ── LLM ─────────────────────────────────────────────────────────────────────
# Google AI Studio key — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token with repo + pull_requests scopes
GITHUB_TOKEN=ghp_...
# Secret set in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Slack ────────────────────────────────────────────────────────────────────
# Incoming webhook URL from your Slack app. Leave blank to disable.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=code_reviews

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Model selection (optional overrides) ─────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
